{
  "name": "poke-quad",
  "productName": "Poke Quad",
  "version": "1.0.0",
  "description": "Quatro navegadores independentes em grid 2x2 para jogar quatro contas de Poke Idle World ao mesmo tempo.",
  "main": "main.js",
  "author": "Poke Quad contributors",
  "repository": "github:meclovim/poke-quad",
  "scripts": {
    "start": "electron .",
    "icon": "node build/gen-icon.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pokequad.app",
    "productName": "Poke Quad",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "build/icon.png"
    ],
    "publish": {
      "provider": "github"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    }
  }
}
